# Copy to .env to override defaults. All variables are optional.
JOBTRAIL_DATA_DIR=data
JOBTRAIL_DB_FILE=jobtrail.db
JOBTRAIL_HOST=127.0.0.1
JOBTRAIL_PORT=8000
JOBTRAIL_OLLAMA_MODEL=qwen3:8b
JOBTRAIL_OLLAMA_HOST=http://localhost:11434
JOBTRAIL_OLLAMA_NUM_CTX=8192
JOBTRAIL_OLLAMA_TIMEOUT=300
JOBTRAIL_STALE_AFTER_DAYS=21
JOBTRAIL_MIN_SAMPLE=20
